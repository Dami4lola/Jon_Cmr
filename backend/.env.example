# =============================================================================
# OBATEK Backend Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Development (SQLite - local file)
DATABASE_URL=sqlite:///./obatek.db

# Production (PostgreSQL - REQUIRED for Railway/Render/etc.)
# DATABASE_URL=postgresql://user:password@host:5432/obatek
# Railway provides this automatically as DATABASE_URL

# -----------------------------------------------------------------------------
# JWT Authentication (CRITICAL - Change in production!)
# -----------------------------------------------------------------------------
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Production example (update with your actual frontend URLs):
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# Google Maps API (for distance calculations)
# Get a key at: https://console.cloud.google.com/apis/credentials
# Enable: Distance Matrix API
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# File Uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# For production with S3/Cloudinary, you may need additional config:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=

# -----------------------------------------------------------------------------
# Business Configuration
# -----------------------------------------------------------------------------
# Office address for distance calculations
OFFICE_ADDRESS=244 Bell Street North, K1R 5T7, Ottawa, Ontario, Canada

# Company credit card last 4 digits (comma-separated if multiple)
# Receipts paid with these cards won't be reimbursed to workers
COMPANY_CARD_DIGITS=5564

# -----------------------------------------------------------------------------
# Railway/Render Deployment Notes
# -----------------------------------------------------------------------------
# Railway automatically sets:
# - PORT (use this in your start command)
# - DATABASE_URL (if you add a PostgreSQL plugin)
#
# You MUST manually set in Railway dashboard:
# - SECRET_KEY (generate a secure one!)
# - CORS_ORIGINS (your frontend URL)
# - GOOGLE_MAPS_API_KEY (optional)
