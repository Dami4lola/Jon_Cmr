# =============================================================================
# OBATEK Frontend Configuration
# =============================================================================
# Copy this file to .env and update values for your environment

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Development (local backend)
VITE_API_URL=http://localhost:8000/api

# Production (update with your deployed backend URL)
# VITE_API_URL=https://your-backend.railway.app/api
# VITE_API_URL=https://api.your-domain.com/api

# -----------------------------------------------------------------------------
# Vercel Deployment Notes
# -----------------------------------------------------------------------------
# In Vercel dashboard, set environment variable:
#   VITE_API_URL = https://your-backend-url.railway.app/api
#
# IMPORTANT: Vite environment variables must be set at BUILD TIME
# They are embedded into the built JavaScript files
#
# If you change the API URL, you must redeploy the frontend

# -----------------------------------------------------------------------------
# Build Commands for Vercel
# -----------------------------------------------------------------------------
# Build Command: npm run build
# Output Directory: dist
# Install Command: npm install
